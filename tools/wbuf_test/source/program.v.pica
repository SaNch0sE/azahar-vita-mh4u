; wbuf_test's vertex shader: the position is clip space as the CPU made it; the colour passes
; through.

.out outpos position
.out outclr color

.alias inpos v0
.alias inclr v1

.entry vmain
.proc vmain
	mov outpos, inpos
	mov outclr, inclr
	end
.end
