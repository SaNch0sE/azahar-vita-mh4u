; vs_inputs_test p5: dp3((12, 12, 5), vd) / 2: (0.95, 0, 0)
.fvec projection[4]
.constf k(0.25, 0.125, 5.0, 1.0)
.constf k2(0.0625, 0.5, 0.0, 1.0)
.constf prod(12.0, 12.0, 5.0, 0.0)
.out outpos position
.out outclr color
.alias inpos v0
.alias va v1
.alias vb v2
.alias vc v3
.alias vd v4
.proc main
	mov r0.xyz, inpos
	mov r0.w, k.w
	dp4 outpos.x, projection[0], r0
	dp4 outpos.y, projection[1], r0
	dp4 outpos.z, projection[2], r0
	dp4 outpos.w, projection[3], r0
	dp3 r5.x, prod, vd
	mul r1.x, k2.y, r5.x
	mov r1.yz, k2.zz
	mov r1.w, k.w
	mov outclr, r1
	end
.end
