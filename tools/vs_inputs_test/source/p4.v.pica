; vs_inputs_test p4: va.yzx * vb.zxy / 16: (0.75, 0.75, 0.3125)
.fvec projection[4]
.constf k(0.25, 0.125, 5.0, 1.0)
.constf k2(0.0625, 0.5, 0.0, 1.0)
.constf prod(12.0, 12.0, 5.0, 0.0)
.out outpos position
.out outclr color
.alias inpos v0
.alias va v1
.alias vb v2
.alias vc v3
.alias vd v4
.proc main
	mov r0.xyz, inpos
	mov r0.w, k.w
	dp4 outpos.x, projection[0], r0
	dp4 outpos.y, projection[1], r0
	dp4 outpos.z, projection[2], r0
	dp4 outpos.w, projection[3], r0
	mov r7, va
	mov r8, vb
	mul r2, r7.yzxw, r8.zxyw
	mul r1, k2.xxxx, r2
	mov r1.w, k.w
	mov outclr, r1
	end
.end
