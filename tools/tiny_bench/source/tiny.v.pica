; tiny_test's vertex program: position (w 1) and unit 0's coordinate, through.
.constf ones(1.0, 1.0, 1.0, 1.0)
.out outpos position
.out outtc0 texcoord0
.alias inpos v0
.alias intc v1
.proc main
	mov outpos.xyz, inpos
	mov outpos.w, ones
	mov outtc0, intc
	end
.end
