; gs_index_test's vertex program: position (w 1) and colour on to the geometry program.
.constf ones(1.0, 1.0, 1.0, 1.0)
.out outpos position
.out outclr color
.alias inpos v0
.alias inclr v1
.proc main
	mov outpos.xyz, inpos
	mov outpos.w, ones
	mov outclr, inclr
	end
.end
