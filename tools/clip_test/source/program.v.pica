; clip_test's vertex shader: the position is clip space as the CPU made it, the colour and three
; texture coordinates pass through (each a varying the clipper interpolates).

.out outpos position
.out outclr color
.out outtc0 texcoord0
.out outtc1 texcoord1
.out outtc2 texcoord2

.alias inpos v0
.alias inclr v1
.alias intc0 v2
.alias intc1 v3
.alias intc2 v4

.entry vmain
.proc vmain
	mov outpos, inpos
	mov outclr, inclr
	mov outtc0, intc0
	mov outtc1, intc1
	mov outtc2, intc2
	end
.end
