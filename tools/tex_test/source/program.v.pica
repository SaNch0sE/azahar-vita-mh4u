; tex_test: the position through the projection, the texture coordinate passed on.
.fvec projection[4]
.constf ones(1.0, 1.0, 1.0, 1.0)
.out outpos position
.out outtc0 texcoord0
.alias inpos v0
.alias intc v1
.proc main
    mov r0.xyz, inpos
    mov r0.w, ones
    dp4 outpos.x, projection[0], r0
    dp4 outpos.y, projection[1], r0
    dp4 outpos.z, projection[2], r0
    dp4 outpos.w, projection[3], r0
    mov outtc0, intc
    end
.end
