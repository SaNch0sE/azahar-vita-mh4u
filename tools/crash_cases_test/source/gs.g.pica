; crash_cases_test's geometry program: each input triangle out again, with six outputs (the
; colour copied into four texture coordinates the fragment stage ignores), so that a draw of
; thousands of triangles stores ~1.7 MiB of triangles (Ace Combat Assault Horizon Legacy+'s
; draw passed sgxd's 2 MiB of pass data so).
.gsh point c0
.fvec projection[4]
.out outpos position
.out outclr color
.out outt0 texcoord0
.out outt1 texcoord1
.out outt2 texcoord2
.out outv view
; v0-v1, v2-v3, v4-v5: position and colour of the triangle's three vertices.
.entry gmain
.proc gmain
	setemit 0
	mov r8, v0
	mov r9, v1
	call vert
	emit
	setemit 1
	mov r8, v2
	mov r9, v3
	call vert
	emit
	setemit 2, prim
	mov r8, v4
	mov r9, v5
	call vert
	emit
	end
.end
.proc vert
	dp4 outpos.x, projection[0], r8
	dp4 outpos.y, projection[1], r8
	dp4 outpos.z, projection[2], r8
	dp4 outpos.w, projection[3], r8
	mov outclr, r9
	mov outt0, r9
	mov outt1, r9
	mov outt2, r9
	mov outv, r9
.end
