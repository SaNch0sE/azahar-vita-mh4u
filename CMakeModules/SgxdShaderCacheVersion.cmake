# The sgxd shader cache's version (sgxd_shader_disk_cache.cpp): a hash of the sources that decide
# what a cached program holds and which key it has (the USSE emitters and encoder, the
# rasterizer's requests and keys, the cache's format, the PICA's shader configurations). A build
# that leaves them alone keeps a player's cache; one that changes them starts a new one.
# cmake -DROOT=<src> -DOUT=<header> -DFILES=<a;b;...> -P SgxdShaderCacheVersion.cmake
set(all "")
foreach(f IN LISTS FILES)
    file(READ "${ROOT}/${f}" contents)
    string(APPEND all "${f}\n${contents}\n")
endforeach()
string(SHA256 hash "${all}")
string(SUBSTRING "${hash}" 0 16 short)
set(text "// Generated by CMakeModules/SgxdShaderCacheVersion.cmake: do not edit.\n#pragma once\n#define SGXD_SHADER_CACHE_VERSION 0x${short}ull\n")
set(old "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL text)
    file(WRITE "${OUT}" "${text}")
endif()
